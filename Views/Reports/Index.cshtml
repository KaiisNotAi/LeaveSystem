@using LeaveSystem.Models.Enums
@using LeaveSystem.Models.ViewModels
@model IEnumerable<LeaveSystem.Models.ViewModels.MyLeaveRequestListItem>
@{
    ViewData["Title"] = "我的請假紀錄查詢";
    var query = ViewData["Query"] as MyLeaveRequestQuery ?? new MyLeaveRequestQuery();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@ViewData["Title"]</h3>
    <a asp-action="Summary" class="btn btn-outline-primary">累計時數統計 →</a>
</div>

@* ─── 篩選表單（GET，條件保留在 URL） ─── *@
<form asp-action="Index" method="get" class="card p-3 mb-3 bg-light">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">狀態</label>
            <select name="Status" class="form-select">
                <option value="">— 不限 —</option>
                @{
                    var statuses = new (LeaveStatus V, string Label)[]
                    {
                        (LeaveStatus.Pending,   "簽核中"),
                        (LeaveStatus.Approved,  "已核准"),
                        (LeaveStatus.Rejected,  "已駁回"),
                        (LeaveStatus.Cancelled, "已撤銷")
                    };
                }
                @foreach (var (v, label) in statuses)
                {
                    if (query.Status == v)
                    {
                        <option value="@v" selected>@label</option>
                    }
                    else
                    {
                        <option value="@v">@label</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">假別</label>
            <select name="LeaveTypeId" class="form-select">
                <option value="">— 不限 —</option>
                @foreach (var opt in query.LeaveTypeOptions)
                {
                    if (query.LeaveTypeId == opt.Id)
                    {
                        <option value="@opt.Id" selected>@opt.Name</option>
                    }
                    else
                    {
                        <option value="@opt.Id">@opt.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">日期起</label>
            <input name="DateFrom" type="date" class="form-control"
                   value="@(query.DateFrom?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">日期迄</label>
            <input name="DateTo" type="date" class="form-control"
                   value="@(query.DateTo?.ToString("yyyy-MM-dd"))" />
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">查詢</button>
        <a asp-action="Index" class="btn btn-outline-secondary">清除條件</a>
    </div>
</form>

@* ─── 結果表格 ─── *@
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>申請編號</th>
                <th>假別</th>
                <th>請假區間</th>
                <th class="text-end">時數</th>
                <th>狀態</th>
                <th>請假原因</th>
                <th>駁回原因</th>
                <th>建立時間</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">沒有符合條件的紀錄</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                var (statusText, badgeClass) = item.Status switch
                {
                    LeaveStatus.Pending => ($"簽核中（第 {item.CurrentLevel} 關）", "bg-warning text-dark"),
                    LeaveStatus.Approved => ("已核准", "bg-success"),
                    LeaveStatus.Rejected => ("已駁回", "bg-danger"),
                    LeaveStatus.Cancelled => ("已撤銷", "bg-secondary"),
                    _ => ("草稿", "bg-info text-dark")
                };

                <tr>
                    <td>#@item.Id</td>
                    <td>@item.LeaveTypeName</td>
                    <td>
                        @item.StartAt.ToString("yyyy-MM-dd HH:mm")
                        <span class="text-muted">~</span>
                        @item.EndAt.ToString("yyyy-MM-dd HH:mm")
                    </td>
                    <td class="text-end">@item.TotalHours</td>
                    <td><span class="badge @badgeClass">@statusText</span></td>
                    <td class="text-muted small" title="@item.Reason">
                        @(item.Reason.Length > 20 ? item.Reason.Substring(0, 20) + "…" : item.Reason)
                    </td>
                    <td class="text-danger small">
                        @(string.IsNullOrEmpty(item.RejectReason) ? "—" : item.RejectReason)
                    </td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
