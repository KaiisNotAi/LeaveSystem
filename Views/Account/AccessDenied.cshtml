@{
    ViewData["Title"] = "拒絕存取";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card border-warning shadow-sm">
            <div class="card-body text-center">
                <h3 class="card-title text-warning">@ViewData["Title"]</h3>
                <p class="card-text">
                    您目前的帳號沒有權限存取這個頁面。<br />
                    如果您認為這是錯誤，請聯絡系統管理員。
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">回首頁</a>
            </div>
        </div>
    </div>
</div>
