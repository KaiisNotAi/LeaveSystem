@using LeaveSystem.Models.ViewModels
@model IEnumerable<LeaveSystem.Models.Entities.ApprovalRule>
@{
    ViewData["Title"] = "簽核規則管理";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@ViewData["Title"]</h3>
    <a asp-action="Create" class="btn btn-primary">＋ 新增規則</a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="alert alert-info small mb-3">
    <strong>規則邏輯：</strong>學員送出的請假時數落在哪個區間（<code>MinHours</code> ~ <code>MaxHours</code>），就依該規則設定的角色順序逐級簽核。
    <br />
    <strong>建議：</strong>區間不要重疊，最高階規則的上限設為「無上限」以涵蓋所有大時數申請。
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th class="text-end">下限（含）</th>
                <th class="text-end">上限（含）</th>
                <th>簽核鏈</th>
                <th>描述</th>
                <th class="text-end">操作</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">尚未建立任何簽核規則</td>
                </tr>
            }
            @foreach (var r in Model)
            {
                var roles = ApprovalRoleJson.Deserialize(r.RequiredRoles);
                <tr>
                    <td class="text-end">@r.MinHours 時</td>
                    <td class="text-end">@(r.MaxHours.HasValue ? $"{r.MaxHours} 時" : "無上限")</td>
                    <td>@ApprovalRoleCatalog.ToDisplay(roles)</td>
                    <td class="text-muted small">@r.Description</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">編輯</a>
                        <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="d-inline"
                              onsubmit="return confirm('確定要刪除這條規則嗎？');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
