@model LeaveSystem.Models.ViewModels.AbsenceRecordAdminViewModel
@{
    ViewData["Title"] = "曠課紀錄管理";
    var q = Model.Query;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@ViewData["Title"]</h3>
    <a asp-action="Create" class="btn btn-primary">＋ 新增曠課紀錄</a>
</div>

@if (TempData["Success"] is string okMsg)
{
    <div class="alert alert-success">@okMsg</div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger">@errMsg</div>
}

@* ─── 篩選表單（GET） ─── *@
<form asp-action="Index" method="get" class="card p-3 mb-3 bg-light">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">班期</label>
            <select name="CohortId" class="form-select">
                <option value="">— 不限 —</option>
                @foreach (var c in Model.CohortOptions)
                {
                    if (q.CohortId == c.Id)
                    {
                        <option value="@c.Id" selected>@c.Name</option>
                    }
                    else
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">學員</label>
            <select name="StudentId" class="form-select">
                <option value="">— 不限 —</option>
                @foreach (var s in Model.StudentOptions)
                {
                    if (q.StudentId == s.Id)
                    {
                        <option value="@s.Id" selected>@s.DisplayName（@s.Username）</option>
                    }
                    else
                    {
                        <option value="@s.Id">@s.DisplayName（@s.Username）</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">日期起</label>
            <input name="DateFrom" type="date" class="form-control"
                   value="@(q.DateFrom?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label class="form-label">日期迄</label>
            <input name="DateTo" type="date" class="form-control"
                   value="@(q.DateTo?.ToString("yyyy-MM-dd"))" />
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">查詢</button>
        <a asp-action="Index" class="btn btn-outline-secondary">清除條件</a>
    </div>
    <div class="mt-2 text-muted small">
        日期以曠課發生時間（<code>OccurredAt</code>）為比對欄位；日期迄含當天。
    </div>
</form>

@* ─── 結果列表 ─── *@
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>學員</th>
                <th>班期</th>
                <th>發生時間</th>
                <th class="text-end">時數</th>
                <th>備註</th>
                <th>登錄者</th>
                <th>登錄時間</th>
                <th class="text-end">操作</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">沒有符合條件的曠課紀錄</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.StudentDisplayName</td>
                        <td>@(item.CohortName ?? "—")</td>
                        <td>@item.OccurredAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">@item.Hours</td>
                        <td>@(item.Note ?? "")</td>
                        <td>@item.CreatedByDisplayName</td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">編輯</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('確定刪除這筆曠課紀錄？');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                            </form>
                        </td>
                    </tr>
                }
                <tr class="fw-bold table-light">
                    <td colspan="3" class="text-end">總計</td>
                    <td class="text-end">@Model.TotalHours</td>
                    <td colspan="4"></td>
                </tr>
            }
        </tbody>
    </table>
</div>
