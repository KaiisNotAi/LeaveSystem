@model IEnumerable<LeaveSystem.Models.Entities.UserAccount>
@{
    ViewData["Title"] = "使用者管理";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@ViewData["Title"]</h3>
    <a asp-action="Create" class="btn btn-primary">＋ 新增使用者</a>
</div>

@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>帳號</th>
                <th>姓名</th>
                <th>Email</th>
                <th>角色</th>
                <th>所屬班期</th>
                <th class="text-center">狀態</th>
                <th class="text-end">操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td><code>@user.Username</code></td>
                    <td>@user.DisplayName</td>
                    <td>@user.Email</td>
                    <td>
                        @foreach (var ur in user.UserRoles)
                        {
                            <span class="badge bg-secondary me-1">@ur.Role?.DisplayName</span>
                        }
                    </td>
                    <td>@(user.Cohort?.Name ?? "—")</td>
                    <td class="text-center">
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">啟用</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">停用</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">編輯</a>
                        <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning">重設密碼</a>
                        <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(user.IsActive ? "停用" : "啟用")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
