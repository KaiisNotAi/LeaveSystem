@model LeaveSystem.Models.ViewModels.AdminExportPageViewModel
@{
    ViewData["Title"] = "匯出報表";
    var q = Model.Query;
    var selectedCohort = q.CohortId;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@ViewData["Title"]</h3>
    <span class="text-muted small">依班期匯出請假 + 曠課明細（Excel 三 sheet 或分別 CSV）</span>
</div>

<form asp-action="Index" method="get" class="card p-3 mb-3 bg-light">
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label">班期 <span class="text-danger">*</span></label>
            <select name="CohortId" class="form-select" id="cohort-select"
                    onchange="filterStudents()">
                <option value="">— 請選擇 —</option>
                @foreach (var c in Model.CohortOptions)
                {
                    if (selectedCohort == c.Id)
                    {
                        <option value="@c.Id" selected>@c.Name</option>
                    }
                    else
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                }
            </select>
            <span asp-validation-for="Query.CohortId" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">學員（未選＝全部）</label>
            <select name="StudentId" class="form-select" id="student-select">
                <option value="">— 全部學生 —</option>
                @foreach (var s in Model.StudentOptions)
                {
                    var selected = q.StudentId == s.Id ? "selected" : null;
                    <option value="@s.Id" data-cohort-id="@s.CohortId" selected="@selected">
                        @s.DisplayName（@s.Username）
                    </option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">日期起</label>
            <input name="DateFrom" type="date" class="form-control"
                   value="@(q.DateFrom?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <label class="form-label">日期迄</label>
            <input name="DateTo" type="date" class="form-control"
                   value="@(q.DateTo?.ToString("yyyy-MM-dd"))" />
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-outline-secondary">套用條件</button>

        @if (selectedCohort.HasValue)
        {
            <button type="submit" formaction="@Url.Action("ExportXlsx")" class="btn btn-success ms-2">
                匯出 Excel（三 sheet）
            </button>
            <button type="submit" formaction="@Url.Action("ExportLeavesCsv")" class="btn btn-outline-success">
                匯出請假 CSV
            </button>
            <button type="submit" formaction="@Url.Action("ExportAbsencesCsv")" class="btn btn-outline-success">
                匯出曠課 CSV
            </button>
        }
        else
        {
            <span class="text-muted ms-2">請先選擇班期，才會顯示匯出按鈕。</span>
        }
    </div>
    <div class="mt-2 text-muted small">
        Excel 匯出包含請假明細（全狀態）、曠課明細、彙總（每學員 × 假別；曠課獨立一列）。
    </div>
</form>

@section Scripts {
    <script>
        // 依所選班期即時過濾學員下拉；「全部學生」永遠可見。
        function filterStudents() {
            const cohort = document.getElementById('cohort-select').value;
            const student = document.getElementById('student-select');
            let visible = 0;
            for (const opt of student.options) {
                if (!opt.value) { opt.hidden = false; continue; }
                const belong = opt.getAttribute('data-cohort-id');
                const match = !cohort || belong === cohort;
                opt.hidden = !match;
                if (match) visible++;
                if (opt.selected && !match) opt.selected = false;
            }
            if (!visible) student.selectedIndex = 0;
        }
        document.addEventListener('DOMContentLoaded', filterStudents);
    </script>
}
