@model IEnumerable<LeaveSystem.Models.Entities.LeaveType>
@{
    ViewData["Title"] = "假別管理";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@ViewData["Title"]</h3>
    <a asp-action="Create" class="btn btn-primary">＋ 新增假別</a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th class="text-end">排序</th>
                <th>名稱</th>
                <th>代碼</th>
                <th>描述</th>
                <th class="text-center">狀態</th>
                <th class="text-end">操作</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">尚未建立任何假別</td>
                </tr>
            }
            @foreach (var t in Model)
            {
                <tr>
                    <td class="text-end">@t.SortOrder</td>
                    <td>@t.Name</td>
                    <td><code>@t.Code</code></td>
                    <td class="text-muted small">@t.Description</td>
                    <td class="text-center">
                        @if (t.IsActive)
                        {
                            <span class="badge bg-success">啟用</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">停用</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">編輯</a>
                        <form asp-action="ToggleActive" asp-route-id="@t.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(t.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(t.IsActive ? "停用" : "啟用")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
