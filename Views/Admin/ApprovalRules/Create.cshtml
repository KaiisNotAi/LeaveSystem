@using LeaveSystem.Models.ViewModels
@model LeaveSystem.Models.ViewModels.ApprovalRuleCreateViewModel
@{
    ViewData["Title"] = "新增簽核規則";
}

<h3>@ViewData["Title"]</h3>

<form asp-action="Create" method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"
         style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="MinHours" class="form-label"></label>
            <input asp-for="MinHours" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="MinHours" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="MaxHours" class="form-label"></label>
            <input asp-for="MaxHours" class="form-control" type="number" step="0.01" min="0"
                   placeholder="留空代表無上限" />
            <span asp-validation-for="MaxHours" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <label class="form-label">@Html.DisplayNameFor(m => m.SelectedRoles)</label>
            <div class="border rounded p-3">
                @foreach (var (val, display) in ApprovalRoleCatalog.All)
                {
                    var isChecked = Model.SelectedRoles.Contains(val);
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox"
                               name="SelectedRoles" value="@val"
                               id="role-@val"
                               @(isChecked ? "checked" : "") />
                        <label class="form-check-label" for="role-@val">@display</label>
                    </div>
                }
            </div>
            <div class="form-text">勾選幾個就代表簽核鏈幾關，實際順序永遠為：導師 → 科長 → 分署長。</div>
            <span asp-validation-for="SelectedRoles" class="text-danger small"></span>
        </div>

        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" placeholder="例：8 小時內由導師決行" />
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">建立</button>
        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
