@model LeaveSystem.Models.ViewModels.CohortCreateViewModel
@{
    ViewData["Title"] = "新增班期";
}

<h3>@ViewData["Title"]</h3>

<form asp-action="Create" method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"
         style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="例：113-1 資安班" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="col-md-3">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" class="form-control" type="date" />
            <span asp-validation-for="StartDate" class="text-danger small"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" class="form-control" type="date" />
            <span asp-validation-for="EndDate" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="TotalHours" class="form-label"></label>
            <input asp-for="TotalHours" class="form-control" type="number" min="1" />
            <span asp-validation-for="TotalHours" class="text-danger small"></span>
            <div class="form-text">整期上課總時數，用於計算請假上限。</div>
        </div>
        <div class="col-md-6">
            <label asp-for="LeaveLimitPercent" class="form-label"></label>
            <input asp-for="LeaveLimitPercent" class="form-control" type="number" min="0" max="100" />
            <span asp-validation-for="LeaveLimitPercent" class="text-danger small"></span>
            <div class="form-text">預設 10%，代表請假時數上限 = 總時數 × 10%。</div>
        </div>

        <div class="col-md-4">
            <label asp-for="TutorUserId" class="form-label"></label>
            <select asp-for="TutorUserId" class="form-select">
                <option value="">— 未指派 —</option>
                @foreach (var u in Model.TutorOptions)
                {
                    <option value="@u.Id">@u.DisplayName（@u.Username）</option>
                }
            </select>
            @if (!Model.TutorOptions.Any())
            {
                <div class="form-text text-warning">目前沒有具「Tutor」角色的使用者，請先到<a asp-controller="Users" asp-action="Index">使用者管理</a>建立。</div>
            }
        </div>
        <div class="col-md-4">
            <label asp-for="SectionChiefUserId" class="form-label"></label>
            <select asp-for="SectionChiefUserId" class="form-select">
                <option value="">— 未指派 —</option>
                @foreach (var u in Model.SectionChiefOptions)
                {
                    <option value="@u.Id">@u.DisplayName（@u.Username）</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="BranchDirectorUserId" class="form-label"></label>
            <select asp-for="BranchDirectorUserId" class="form-select">
                <option value="">— 未指派 —</option>
                @foreach (var u in Model.BranchDirectorOptions)
                {
                    <option value="@u.Id">@u.DisplayName（@u.Username）</option>
                }
            </select>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">建立</button>
        <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
