@{
    ViewData["Title"] = "首頁";
}

<div class="text-center mb-4">
    <h1 class="display-4">學生請假系統</h1>
    <p class="lead">線上化請假流程，三方協作更有效率</p>
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <p class="text-muted">您好，@User.Identity.Name！您目前的角色：
            @{
                var roles = ((System.Security.Claims.ClaimsIdentity)User.Identity)
                    .FindAll(System.Security.Claims.ClaimTypes.Role)
                    .Select(c => c.Value)
                    .ToList();
            }
            @foreach (var r in roles)
            {
                <span class="badge bg-secondary">@r</span>
            }
        </p>
    }
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">📝 學員</h5>
                <p class="card-text">提交請假申請、查詢個人累計時數、追蹤簽核進度。</p>
                @if (User.IsInRole("Student"))
                {
                    <a href="/LeaveRequests" class="btn btn-outline-primary btn-sm">學員入口</a>
                }
                else
                {
                    <button class="btn btn-outline-secondary btn-sm" disabled>需 Student 權限</button>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">✅ 簽核人</h5>
                <p class="card-text">導師、科長、分署長集中處理待簽核申請，留下簽核意見。</p>
                <a href="#" class="btn btn-outline-primary btn-sm disabled">簽核入口（Phase 4 開放）</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">⚙ 行政／管理員</h5>
                <p class="card-text">管理帳號、班期、假別、簽核規則，登錄曠課時數，匯總報表。</p>
                @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                {
                    <a href="/Admin/Users" class="btn btn-outline-primary btn-sm">使用者管理</a>
                }
                else
                {
                    <button class="btn btn-outline-secondary btn-sm" disabled>需 Admin / Staff 權限</button>
                }
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info mt-4 small">
    本系統正逐步建置中，目前處於 <strong>Phase 3：學員請假申請</strong>。
    完整功能將依開發階段與里程碑分階段交付。
</div>
