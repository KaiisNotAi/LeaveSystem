@model LeaveSystem.Models.ViewModels.NotificationIndexViewModel
@{
    ViewData["Title"] = "通知中心";
}

<h2>🔔 通知中心 <small class="text-muted">(未讀 @Model.UnreadCount 則)</small></h2>

@if (TempData["Success"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<form asp-action="MarkAllRead" method="post" class="mb-3">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-outline-primary btn-sm" @(Model.UnreadCount == 0 ? "disabled" : null)>全部標記為已讀</button>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">目前沒有任何通知。</div>
}
else
{
    <div class="list-group">
        @foreach (var n in Model.Items)
        {
            var cls = n.IsRead ? "list-group-item" : "list-group-item list-group-item-warning";
            <div class="@cls d-flex justify-content-between align-items-start">
                <div class="me-3">
                    <div class="fw-bold">
                        @if (!n.IsRead)
                        {
                            <span class="badge bg-danger me-1">新</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(n.Url))
                        {
                            <a asp-action="Go" asp-route-id="@n.Id" class="text-decoration-none">@n.Title</a>
                        }
                        else
                        {
                            @n.Title
                        }
                    </div>
                    <div class="small">@n.Message</div>
                    <div class="text-muted small">@n.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</div>
                </div>
                <div>
                    @if (!n.IsRead)
                    {
                        <form asp-action="MarkRead" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">標記已讀</button>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-secondary">已讀</span>
                    }
                </div>
            </div>
        }
    </div>
}
