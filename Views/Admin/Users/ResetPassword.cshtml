@model LeaveSystem.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "重設密碼";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h3>@ViewData["Title"]</h3>
        <p class="text-muted">為使用者 <code>@Model.Username</code> 設定新的初始密碼。</p>

        <form asp-action="ResetPassword" method="post" class="mt-3">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Username" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"
                 style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <div class="form-text">建議請使用者於下次登入後再自行修改密碼。</div>
            </div>

            <button type="submit" class="btn btn-warning">重設密碼</button>
            <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
